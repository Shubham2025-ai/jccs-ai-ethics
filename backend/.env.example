# JCCS Backend Environment Variables Example
# Copy this file to .env and configure your local or production settings

# Database Configuration (MySQL for local dev or SQLite for lightweight / cloud deployments)
USE_SQLITE=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jccs_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Groq API Configuration (for LLaMA 3.3 70B IndiaAI Safety Judge)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Application Security & CORS
DEBUG=false
APP_NAME=JCCS - AI Ethics & Safety Auditing Platform
APP_VERSION=2.0.0
SECRET_KEY=your_random_secret_signing_key_here
FRONTEND_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads/
